{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "Otlp": {
      "Enabled": false,
      "Endpoint": "http://localhost:4317"
    },
    "Zipkin": {
      "Enabled": false,
      "Endpoint": "http://localhost:9411/api/v2/spans"
    },
    "Prometheus": {
      "Enabled": false,
      "ScrapeEndpointPath": "/metrics"
    }
  }
}
